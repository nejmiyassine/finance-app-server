{
    "name": "finance-app-server",
    "version": "1.0.0",
    "description": "A minimal, production-ready starter template for building **Express.js APIs** using **TypeScript** and **Bun**. Includes common middleware, linting, formatting, and environment configuration out of the box to help you scaffold quickly, stay consistent, and ship with confidence.",
    "author": "",
    "license": "ISC",
    "main": "src/server.ts",
    "engines": {
        "bun": "1.3.14"
    },
    "packageManager": "bun@1.3.14",
    "scripts": {
        "dev": "bun --watch src/server.ts ",
        "start": "bun --bun run src/server.ts",
        "lint": "eslint --ext .ts src",
        "lint:fix": "eslint --ext .ts src --fix",
        "check:updates": "ncu --target minor"
    },
    "dependencies": {
        "compression": "^1.8.2",
        "dotenv": "^18.0.9",
        "express": "^5.3.0",
        "helmet": "^8.3.0",
        "morgan": "^1.12.1"
    },
    "devDependencies": {
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.6",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.6.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-config-standard-with-typescript": "^43.0.1",
        "npm-check-updates": "^23.1.1",
        "typescript": "^7.0.2"
    },
    "keywords": []
}
